<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>Kanvas</id>
    <version>2.1.40</version>
    <description>A library containing image transcodings and quantizations usable in the Kuriimu2 eco-system.</description>

    <authors>onepiecefreak;IcySon55</authors>
    <owners>onepiecefreak;IcySon55</owners>
    <copyright>Copyright (c) 2024 Fan Translators International</copyright>

    <projectUrl>https://github.com/FanTranslatorsInternational/Kuriimu2</projectUrl>
    <icon>kuriimu2icon.png</icon>
    <tags>Kuriimu2;Image;Transcoding;Quantization</tags>

    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">GPL-3.0-only</license>

    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="PVRTexLib.NET" version="1.0.3" />
        <dependency id="BCnEncoder.Net" version="2.2.1" />
        <dependency id="SixLabors.ImageSharp" version="3.1.12" />
        <dependency id="Komponent" version="2.1.9" />
      </group>
    </dependencies>
  </metadata>

  <files>
    <file src="bin\Release\net10.0\*.dll" target="lib\net10.0\"/>
    <file src="..\..\..\kuriimu2icon.png" target="kuriimu2icon.png"/>
  </files>
</package>